              },
              {
                "textRuns": [
                  {
                    "value": "2. Track fraud per $10B of deposits every quarter. ",
                    "textStyle": {
                      "color": "#111111",
                      "fontSize": "11pt",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Truist crossed Chase in 2026; flag it if the gap keeps widening.",
