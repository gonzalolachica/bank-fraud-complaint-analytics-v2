    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "WHAT IT FOUND",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#2f3e4e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Truist broke its normal range 7 times since 2021, twice in the last 12 complete months (Sep 2025, Jan 2026), in step with its 2026 rise.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#111418"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• January 2025 is the biggest spike in the data: 792 fraud complaints, 703 of them at Chase. Truist also flagged that month.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#111418"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "6pt",
                      "color": "#111418"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "CAVEATS",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#2f3e4e"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Small numbers: Truist gets roughly 40 to 50 fraud complaints a month, so random swings are large. An alert is a prompt to investigate, not proof.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#4d545c"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• A spike raises the next 12 months of baseline (Jan 2025 widened the 2025–26 band), so later spikes are harder to flag.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#4d545c"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "• Complaints show customer pain, not fraud losses.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#4d545c"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
