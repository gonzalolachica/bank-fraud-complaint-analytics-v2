model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["fct_complaints","dim_date","dim_issue","dim_geography","dim_company","dim_product","bank_size","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table fct_complaints
ref table dim_date
ref table dim_issue
ref table dim_geography
ref table dim_company
ref table dim_product
ref table bank_size
ref table _Measures

ref cultureInfo en-US

